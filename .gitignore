# ------------------------------------------------------------
# Archivos excluidos del control de versiones
# ------------------------------------------------------------
# Rutas propias de cada máquina
configs/paths.local.yaml

# Datos y resultados pesados: se almacenan fuera del repositorio (rutas en configs/paths.local.yaml)
data/
runs/
*.dcm
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.tif
*.tiff
*.zip
*.tar
*.gz

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
*.egg-info/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# LaTeX (archivos auxiliares de compilación)
*.aux
*.log
*.out
*.synctex.gz
*.bbl
*.blg

# Los logs de entrenamiento exportados a reports/ sí se versionan
!p1_rodilla/reports/**/*.log
!p3_fauna/reports/**/*.log
