<graph id="S1_GRD_a_dB">
  <version>1.0</version>
  <node id="Read">
    <operator>Read</operator>
    <parameters>
      <file>${input}</file>
    </parameters>
  </node>
  <node id="Orbita">
    <operator>Apply-Orbit-File</operator>
    <sources><sourceProduct refid="Read"/></sources>
    <parameters>
      <orbitType>Sentinel Precise (Auto Download)</orbitType>
      <polyDegree>3</polyDegree>
      <continueOnFail>true</continueOnFail>
    </parameters>
  </node>
  <node id="RuidoTermico">
    <operator>ThermalNoiseRemoval</operator>
    <sources><sourceProduct refid="Orbita"/></sources>
    <parameters>
      <selectedPolarisations>VH,VV</selectedPolarisations>
      <removeThermalNoise>true</removeThermalNoise>
    </parameters>
  </node>
  <node id="Calibracion">
    <operator>Calibration</operator>
    <sources><sourceProduct refid="RuidoTermico"/></sources>
    <parameters>
      <selectedPolarisations>VH,VV</selectedPolarisations>
      <outputSigmaBand>true</outputSigmaBand>
      <outputGammaBand>false</outputGammaBand>
      <outputBetaBand>false</outputBetaBand>
    </parameters>
  </node>
  <node id="Terreno">
    <operator>Terrain-Correction</operator>
    <sources><sourceProduct refid="Calibracion"/></sources>
    <parameters>
      <demName>SRTM 1Sec HGT</demName>
      <demResamplingMethod>BILINEAR_INTERPOLATION</demResamplingMethod>
      <imgResamplingMethod>BILINEAR_INTERPOLATION</imgResamplingMethod>
      <pixelSpacingInMeter>10.0</pixelSpacingInMeter>
      <mapProjection>EPSG:4326</mapProjection>
      <nodataValueAtSea>false</nodataValueAtSea>
      <saveSelectedSourceBand>true</saveSelectedSourceBand>
    </parameters>
  </node>
  <node id="Recorte">
    <operator>Subset</operator>
    <sources><sourceProduct refid="Terreno"/></sources>
    <parameters>
      <geoRegion>POLYGON((-77.17 -12.07, -76.83 -12.07, -76.83 -11.74, -77.17 -11.74, -77.17 -12.07))</geoRegion>
      <copyMetadata>false</copyMetadata>
    </parameters>
  </node>
  <node id="dB">
    <operator>LinearToFromdB</operator>
    <sources><sourceProduct refid="Recorte"/></sources>
  </node>
  <node id="Write">
    <operator>Write</operator>
    <sources><sourceProduct refid="dB"/></sources>
    <parameters>
      <file>${output}</file>
      <formatName>GeoTIFF-BigTIFF</formatName>
    </parameters>
  </node>
</graph>
